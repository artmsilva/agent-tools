GHOSTTY = shutil.which("ghostty") or "/Applications/Ghostty.app/Contents/MacOS/ghostty"
PI_ROOT = Path.home() / ".pi/agent/themes"
PI_OUTPUT = PI_ROOT / "ghostty"
PI_CURRENT = PI_ROOT / "Ghostty Current.json"
LEGACY_PI_CURRENT = PI_OUTPUT / "current.json"
PI_SETTINGS = Path.home() / ".pi/agent/settings.json"
HERDR_CONFIG = Path(os.environ.get("HERDR_CONFIG_PATH", Path.home() / ".config/herdr/config.toml"))
ZED_SETTINGS = Path.home() / ".config/zed/settings.json"
SCHEMA = "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json"

PI_REQUIRED = {
