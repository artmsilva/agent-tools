{
  "name": "pi-agent-teams",
  "version": "0.1.0",
  "description": "Hardened Pi agent teams with shared tasks, worktrees, Herdr panes, and headless fallback.",
  "license": "MIT",
  "author": "Arturo Silva",
  "contributors": ["Thomas Mustier and pi-agent-teams contributors"],
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artmsilva/agent-tools.git",
    "directory": "packages/pi-agent-teams"
  },
  "bugs": "https://github.com/artmsilva/agent-tools/issues",
  "homepage": "https://github.com/artmsilva/agent-tools/tree/main/packages/pi-agent-teams#readme",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "lint": "eslint 'extensions/**/*.ts' 'scripts/**/*.ts' 'scripts/**/*.mts'",
    "typecheck": "tsc -p tsconfig.strict.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run smoke-test",
    "test": "node --import tsx --test 'extensions/teams/*.test.ts'",
    "smoke-test": "tsx scripts/smoke-test.mts",
    "e2e-rpc-test": "node scripts/e2e-rpc-test.mjs",
    "integration-claim-test": "tsx scripts/integration-claim-test.mts",
    "integration-herdr-test": "tsx scripts/integration-herdr-test.mts",
    "integration-spawn-overrides-test": "tsx scripts/integration-spawn-overrides-test.mts",
    "integration-hooks-remediation-test": "tsx scripts/integration-hooks-remediation-test.mts",
    "integration-todo-test": "tsx scripts/integration-todo-test.mts",
    "integration-cleanup-test": "tsx scripts/integration-cleanup-test.mts",
    "integration-branch-context-test": "tsx scripts/integration-branch-context-test.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@sinclair/typebox": "^0.34.48",
    "eslint": "^9.39.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.83.0",
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0",
    "@sinclair/typebox": "*"
  }
}
